{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowWESADIngestion",
            "Effect": "Allow",
            "Action": [
                "s3:PutObject",
                "s3:PutObjectAcl"
            ],
            "Resource": "arn:aws:s3:::hcai-wesad-bronze-landing/*"
        },
        {
            "Sid": "AllowWESADDiscovery",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::hcai-wesad-bronze-landing"
        }
    ]
}
